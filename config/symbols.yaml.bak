# Data4Trend 交易对配置文件
# 支持的时间间隔: 1m, 3m, 5m, 15m, 30m, 1h, 2h, 4h, 6h, 8h, 12h, 1d, 3d, 1w, 1M

# 数据库配置
clickhouse:
  host: "localhost"
  port: 9000
  http_port: 8123
  database: "data4trend"
  user: "default"
  password: "123456"
  max_open_conns: 10
  max_idle_conns: 5
  conn_max_lifetime: "1h"

# Binance API配置
binance:
  api_key: ""
  secret_key: ""
  base_url: "https://api.binance.com"

# HTTP客户端配置
http:
  timeout: 120
  # 如果不需要代理，请注释掉下面这行
  # proxy: "http://127.0.0.1:7890"

# 性能配置
performance:
  workers: 25
  data_channel_buffer: 1000
  task_queue_size: 800

# 日志配置
log:
  level: "info"
  format: "json"
  output_path: "logs/data4trend.log"
  max_size: 100
  max_backups: 3
  max_age: 28
  compress: true

symbols:
  - symbol: "BTCUSDT"
    enabled: true
    start_time: "2019-01-01T00:00:00Z"  # 可选，如果不设置则使用默认时间
    intervals:
      - "1m"
      - "5m"
      - "15m"
      - "1h"
      - "4h"
      - "1d"
  
  - symbol: "ETHUSDT"
    enabled: true
    start_time: "2019-01-01T00:00:00Z"
    intervals:
      - "1m"
      - "5m"
      - "15m"
      - "1h"
      - "4h"
      - "1d"
  
  - symbol: "BNBUSDT"
    enabled: true
    start_time: "2019-01-01T00:00:00Z"
    intervals:
      - "1m"
      - "5m"
      - "15m"
      - "1h"
      - "4h"
      - "1d"
  
  - symbol: "ADAUSDT"
    enabled: false  # 可以通过设置enabled为false来禁用某个交易对
    intervals:
      - "1m"
      - "5m"
      - "15m"
      - "1h"
      - "4h"
      - "1d"